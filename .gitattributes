# Normalize line endings; scripts that run inside Linux containers must stay LF
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.parquet binary
*.joblib binary
*.gz binary
*.zip binary
