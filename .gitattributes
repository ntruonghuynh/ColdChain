# Normalize line endings; scripts that run inside Linux containers must stay LF
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.parquet binary
*.joblib binary
*.gz binary
*.zip binary

# Dataset releases are verified byte-for-byte against manifest.json: never convert line endings.
data/release/** -text
# The simulator configuration is hashed into every dataset fingerprint: always LF.
data/generator/config/*.yaml text eol=lf
