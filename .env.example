# Copy this file to .env and adjust values. Never commit .env.
# Values here are placeholders for LOCAL DEVELOPMENT ONLY.
# Variables are planned in docs/architecture.md; each is used from the milestone noted.

# ---------- General (M1) ----------
COMPOSE_PROJECT_NAME=coldchain-demo-template
APP_ENV=local
TZ=UTC

# Use project-specific image tags. M5's historical Compose file uses :local/:test;
# M6 uses separate tags so builds on this branch do not overwrite M5 references.
BACKEND_IMAGE=coldchain-backend:demo-template
BACKEND_TEST_IMAGE=coldchain-backend:test-demo-template
CHAIN_IMAGE=coldchain-chain:demo-template
FRONTEND_IMAGE=coldchain-frontend:demo-template

# ---------- Database (M1) ----------
# The database is only reachable inside the Docker network (no host port is published).
# If you change the password AFTER the first start, the existing data volume keeps the
# old password; see README "Troubleshooting".
POSTGRES_DB=coldchain
POSTGRES_USER=coldchain
# Generated by scripts/setup_local_env.py or scripts/setup_local_env.ps1 on first run.
POSTGRES_PASSWORD=

# ---------- Web access (M1) ----------
# The dashboard and the API (under /api) are served at http://localhost:FRONTEND_PORT
FRONTEND_PORT=3000
# 127.0.0.1 = only this computer can open the app. Use 0.0.0.0 to allow other devices on the network.
FRONTEND_BIND_ADDRESS=127.0.0.1

# ---------- Authentication (M5 local demo) ----------
# Generate each password independently and set values locally; do not commit secrets.
# After copying this file, run `python scripts/setup_local_env.py` to generate
# local secrets. It replaces the JWT placeholder if present and preserves valid keys.
JWT_SECRET=
JWT_EXPIRES_MIN=120
SHIPPER_DEMO_PASSWORD=
CARRIER_DEMO_PASSWORD=
QUALITY_DEMO_PASSWORD=
WAREHOUSE_DEMO_PASSWORD=
ADMIN_DEMO_PASSWORD=
AUDIT_SIGNING_KEY=

# ---------- Synthetic data (M2) ----------
# Seed roles (decision A-13): 11 = canonical development dataset (data/release/);
# 22,33,44,55,66 = reserved for operational simulation evaluation (M9).
# Informational in M2: the generator CLI takes seeds as arguments.
SIM_CANONICAL_SEED=11
SIM_EVALUATION_SEEDS=22,33,44,55,66
SIM_JOURNEYS_PER_SEED=200

# ---------- Machine learning (M4) ----------
# Frozen model version to serve, e.g. a folder name under ml/registry/
ML_MODEL_VERSION=

# ---------- Blockchain (M5) ----------
CHAIN_RPC_URL=http://chain:8545
CHAIN_ID=31337
CHAIN_PORT=8545
CHAIN_BIND_ADDRESS=127.0.0.1
# Optional local-only test mnemonic override; keep identical for the chain and backend.
CHAIN_MNEMONIC=
# Local Hardhat dev accounts are derived from Hardhat's public test mnemonic by index.
# Do not put private keys in this file.
CHAIN_ACCOUNT_INDEX_ADMIN=0
CHAIN_ACCOUNT_INDEX_SHIPPER=1
CHAIN_ACCOUNT_INDEX_CARRIER=2
CHAIN_ACCOUNT_INDEX_QUALITY=3
CHAIN_ACCOUNT_INDEX_WAREHOUSE=4
CHAIN_ACCOUNT_INDEX_MONITOR=5
CHAIN_CONFIRMATIONS=1
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_DELAY_MS=500

# ---------- LLM / RAG (M6) ----------
M6_RUNTIME_VERSION=m6-source-unversioned
# Optional OpenAI Chat Completions-compatible provider (hosted or local).
# Leave disabled for startup without external API calls. No model is downloaded at startup.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_FALLBACK_ENABLED=false
# Optional price table values per million tokens. Leave blank to record cost as unknown.
LLM_PRICE_INPUT_PER_MTOK_USD=
LLM_PRICE_OUTPUT_PER_MTOK_USD=
