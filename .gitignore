# ---- Data, models and evaluation scratch output ----
# Canonical released artifacts (data/release/, ml/registry/<version>/, docs/evaluation/runs/)
# are tracked on purpose; only scratch output is ignored.
data/generated/
ml/scratch/
scripts/eval/scratch/

# ---- Packaging (root-level output only; data/release/ is tracked) ----
/release/
*.zip

# ---- Logs ----
*.log
logs/
